# Copy this file to .env.mariadb.local. The local file is ignored by Git and
# excluded from container build contexts. Never commit real credentials.

# Pin the database version. Match this to the productive MariaDB major/minor
# before importing real data.
MARIADB_IMAGE=mariadb:11.4.10
MARIADB_SERVER_VERSION=11.4.10-MariaDB
PARTDB_IMAGE=ghcr.io/maxluther95/part-db-server:current

PARTDB_DB_NAME=partdb
PARTDB_DB_USER=partdb

# Use independent URL-safe random values, for example `openssl rand -hex 32`.
PARTDB_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
PARTDB_APP_SECRET=REPLACE_WITH_A_THIRD_RANDOM_HEX

# Safe local default. Use 0.0.0.0 only when LAN access is intended and update
# PARTDB_TRUSTED_HOSTS accordingly.
PARTDB_HTTP_BIND=127.0.0.1
PARTDB_HTTP_PORT=8081
PARTDB_TRUSTED_HOSTS='^(localhost|127[.]0[.]0[.]1)$'

PARTDB_DEFAULT_LANG=de
PARTDB_TIMEZONE=Europe/Berlin
PARTDB_BASE_CURRENCY=EUR
PARTDB_INSTANCE_NAME=Part-DB MariaDB

# Keep migrations explicit. Set this to true only after backups and a migration
# rehearsal have been established.
PARTDB_DB_AUTOMIGRATE=false

PARTDB_CHECK_FOR_UPDATES=0
PARTDB_USE_GRAVATAR=0
PARTDB_ALLOW_ATTACHMENT_DOWNLOADS=0
