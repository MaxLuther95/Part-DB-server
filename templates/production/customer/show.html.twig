{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ customer }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-address-book fa-fw"></i> {{ customer }}{% endblock %}

{% block card_content %}
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="{{ path('production_customer_index') }}">
            <i class="fa-solid fa-arrow-left fa-fw"></i> {{ 'production.customer.plural'|trans }}
        </a>
        {% if is_granted('@projects.edit') %}
            <a class="btn btn-primary" href="{{ path('production_customer_edit', {id: customer.id}) }}">
                <i class="fa-solid fa-pen fa-fw"></i> {{ 'production.action.edit'|trans }}
            </a>
            <a class="btn btn-success" href="{{ path('production_customer_project_new', {customer: customer.id}) }}">
                <i class="fa-solid fa-plus fa-fw"></i> {{ 'production.customer_project.new'|trans }}
            </a>
        {% endif %}
    </div>
    <dl class="row">
        <dt class="col-sm-3">{{ 'production.customer.number'|trans }}</dt><dd class="col-sm-9">{{ customer.customerNumber }}</dd>
        <dt class="col-sm-3">{{ 'production.customer.active'|trans }}</dt><dd class="col-sm-9">{{ (customer.active ? 'production.common.yes' : 'production.common.no')|trans }}</dd>
        <dt class="col-sm-3">{{ 'production.common.description'|trans }}</dt><dd class="col-sm-9">{{ customer.description|default('–')|nl2br }}</dd>
    </dl>
    <h2 class="h5 mt-4">{{ 'production.customer_project.plural'|trans }}</h2>
    <div class="list-group">
        {% for project in customer.projects %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path('production_customer_project_show', {id: project.id}) }}">
                <span>{{ project }}</span><span class="badge bg-secondary">{{ ('production.customer_project.status.' ~ project.status.value)|trans }}</span>
            </a>
        {% else %}
            <div class="list-group-item text-muted">{{ 'production.common.empty'|trans }}</div>
        {% endfor %}
    </div>
{% endblock %}
