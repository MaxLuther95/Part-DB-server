* { box-sizing: border-box; }
.datasheet-page { color: #20252a; font-family: DejaVu Sans, Arial, sans-serif; font-size: 9.5pt; line-height: 1.35; position: relative; }
.datasheet-header { border-bottom: 1.5px solid #9e3836; margin-bottom: 7mm; padding-bottom: 3mm; position: relative; }
.datasheet-header h1 { color: #783331; font-size: 16pt; margin: 0; overflow-wrap: anywhere; }
.datasheet-kicker { color: #775757; font-size: 8pt; font-weight: bold; letter-spacing: 1.4pt; }
.datasheet-fixed-fields { border: 1px solid #dbc8c7; display: table; margin-bottom: 6mm; table-layout: fixed; width: 100%; }
.datasheet-fixed-field { border-right: 1px solid #dbc8c7; display: table-cell; padding: 2mm 2.5mm; width: 33.333%; }
.datasheet-fixed-field:last-child { border-right: 0; }
.datasheet-fixed-value { font-size: 9pt; min-height: 4mm; overflow-wrap: anywhere; padding-top: .5mm; }
.datasheet-watermark { color: rgba(158, 56, 54, .10); font-size: 56pt; font-weight: bold; left: 25mm; position: absolute; top: 105mm; transform: rotate(-32deg); z-index: 0; }
.datasheet-body { font-size: 0; margin: 0 -2mm; position: relative; z-index: 1; }
.datasheet-block { display: inline-block; font-size: 9.5pt; padding: 0; vertical-align: top; }
.datasheet-block-full { display: block; }
.datasheet-block-spacer { clear: both; display: block; page-break-inside: avoid; width: 100% !important; }
.datasheet-block-spacer .datasheet-block-inner { padding: 0; }
.datasheet-block-spacer .datasheet-spacer { height: 4mm; }
.datasheet-block-spacer.datasheet-text-size-normal .datasheet-spacer { height: 8mm; }
.datasheet-block-spacer.datasheet-text-size-large .datasheet-spacer { height: 12mm; }
.datasheet-block-spacer.datasheet-text-size-extra_large .datasheet-spacer { height: 16mm; }
.datasheet-block-inner { overflow-wrap: anywhere; padding: 0 2mm 4mm; }
.datasheet-clear { clear: both; display: block; height: 0; width: 100%; }
.datasheet-block h2 { border-bottom: 1px solid #dbc8c7; color: #873d3b; font-size: 13pt; font-weight: normal; margin: 2mm 0 3mm; padding-bottom: 1mm; page-break-after: avoid; }
.datasheet-block h3 { color: #873d3b; font-size: 10pt; margin: 0 0 1.5mm; page-break-after: avoid; }
.datasheet-text { font-size: 9.5pt; }
.datasheet-block-heading.datasheet-text-size-small h2 { font-size: 10pt; }
.datasheet-block-heading.datasheet-text-size-normal h2 { font-size: 13pt; }
.datasheet-block-heading.datasheet-text-size-large h2 { font-size: 16pt; }
.datasheet-block-heading.datasheet-text-size-extra_large h2 { font-size: 20pt; }
.datasheet-block-static_text.datasheet-text-size-small .datasheet-text { font-size: 8pt; }
.datasheet-block-static_text.datasheet-text-size-normal .datasheet-text { font-size: 9.5pt; }
.datasheet-block-static_text.datasheet-text-size-large .datasheet-text { font-size: 12pt; }
.datasheet-block-static_text.datasheet-text-size-extra_large .datasheet-text { font-size: 15pt; }
.datasheet-block-editable_note.datasheet-text-size-small .datasheet-note, .datasheet-block-value.datasheet-text-size-small .datasheet-value, .datasheet-block-child_table.datasheet-text-size-small { font-size: 8pt; }
.datasheet-block-editable_note.datasheet-text-size-normal .datasheet-note, .datasheet-block-value.datasheet-text-size-normal .datasheet-value, .datasheet-block-child_table.datasheet-text-size-normal { font-size: 9.5pt; }
.datasheet-block-editable_note.datasheet-text-size-large .datasheet-note, .datasheet-block-value.datasheet-text-size-large .datasheet-value, .datasheet-block-child_table.datasheet-text-size-large { font-size: 12pt; }
.datasheet-block-editable_note.datasheet-text-size-extra_large .datasheet-note, .datasheet-block-value.datasheet-text-size-extra_large .datasheet-value, .datasheet-block-child_table.datasheet-text-size-extra_large { font-size: 15pt; }
.datasheet-font-sans_serif { font-family: DejaVu Sans, Arial, sans-serif; }
.datasheet-font-serif { font-family: DejaVu Serif, Georgia, serif; }
.datasheet-font-monospace { font-family: DejaVu Sans Mono, monospace; }
.datasheet-align-left { text-align: left; }
.datasheet-align-center { text-align: center; }
.datasheet-align-right { text-align: right; }
.datasheet-text-bold, .datasheet-text-bold h2, .datasheet-text-bold h3 { font-weight: bold; }
.datasheet-text-italic, .datasheet-text-italic h2, .datasheet-text-italic h3 { font-style: italic; }
.datasheet-text-underlined, .datasheet-text-underlined h2, .datasheet-text-underlined h3 { text-decoration: underline; }
.datasheet-align-center .datasheet-table th, .datasheet-align-center .datasheet-table td { text-align: center; }
.datasheet-align-right .datasheet-table th, .datasheet-align-right .datasheet-table td { text-align: right; }
.datasheet-value-label { color: #775757; font-size: 7.5pt; font-weight: bold; text-transform: uppercase; }
.datasheet-value { border-bottom: 1px solid #dbc8c7; min-height: 6mm; padding: 1mm 0; }
.datasheet-note { background: #fbf7f7; border-left: 2px solid #c79e9c; min-height: 12mm; padding: 2mm; white-space: pre-wrap; }
.datasheet-table { border-collapse: collapse; width: 100%; }
.datasheet-table th, .datasheet-table td { border: .6pt solid #dbc8c7; padding: 1.5mm; overflow-wrap: anywhere; }
.datasheet-table th { background: #f4e9e8; color: #783331; font-size: inherit; text-align: left; }
.datasheet-table tbody th { background: #fcf9f9; color: #20252a; font-weight: normal; }
.datasheet-table thead { display: table-header-group; }
.datasheet-header-warning { color: #923e3b; font-size: 7pt; font-weight: normal; margin-top: 1mm; }
.datasheet-table tr { page-break-inside: avoid; }
.datasheet-block-separator { padding-bottom: 2mm; }
.datasheet-block-separator hr { border: 0; border-top: 1px solid #c79e9c; }
.datasheet-page-break { page-break-after: always; }
.datasheet-footer { border-top: .6pt solid #dbc8c7; color: #775757; font-size: 6.5pt; padding-top: 2mm; text-align: center; }
.datasheet-logo { display: block; height: auto; margin: 0 auto 1mm; width: 44mm; }
