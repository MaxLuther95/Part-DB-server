{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ template.productTitle }} · {{ instance.displayIdentifier }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-file-pdf fa-fw"></i> Datenblatt vorbereiten{% endblock %}

{% block card_content %}
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="{{ path('production_build_instance_show', {id: instance.id}) }}"><i class="fa-solid fa-arrow-left fa-fw"></i> {{ instance.displayIdentifier }}</a>
        <a class="btn btn-outline-secondary" href="{{ path('production_datasheet_template_show', {id: template.id}) }}">Vorlage anzeigen</a>
    </div>
    <p>Prüfe die Angaben zunächst in der DRAFT-Vorschau. Mit der Freigabe wird das offizielle Datenblatt unveränderlich gespeichert.</p>
    <dl class="row">
        <dt class="col-sm-3">Product title</dt><dd class="col-sm-9">{{ template.productTitle }}</dd>
        <dt class="col-sm-3">Build instance</dt><dd class="col-sm-9">{{ instance.displayIdentifier }} · {{ instance.contentName }}</dd>
        <dt class="col-sm-3">Template revision</dt><dd class="col-sm-9">{{ revision.revisionNumber }}</dd>
    </dl>

    <form method="post" action="{{ path('production_datasheet_release', {instance: instance.id, template: template.id}) }}" {{ stimulus_controller('production/datasheet-release production/datasheet-additional-notes') }} data-confirm-title="Kundendatenblatt freigeben" data-confirm-message="Die erzeugte PDF wird unveränderlich gespeichert. Korrekturen erzeugen anschließend eine neue Dokumentrevision.">
        {% if release_errors|default([]) is not empty %}
            <div class="alert alert-danger" data-release-errors><strong>Diese Angaben müssen vor der Freigabe korrigiert werden:</strong><ul class="mb-0">{% for error in release_errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
        {% endif %}
        {% include 'production/_incomplete_warning.html.twig' %}
        <input type="hidden" name="_token" value="{{ csrf_token('datasheet_preview_' ~ instance.id ~ '_' ~ template.id) }}">
        {% for key, choice in run_choices %}
            <div class="mb-3"><label class="form-label" for="datasheet-run-{{ key }}">Laufzettel für {{ choice.instance.displayIdentifier }}</label><select class="form-select" id="datasheet-run-{{ key }}" name="runs[{{ key }}]" required><option value="">Bitte eindeutig auswählen</option>{% for run in choice.runs %}<option value="{{ run.id }}"{{ selected_runs[key]|default(null) == run.id ? ' selected' : '' }}>{{ run.revision.template.name }} #{{ run.runNumber }} · fertiggestellt {{ run.completedAt|format_datetime('short', 'short') }}</option>{% endfor %}</select><div class="form-text">Mehrere abgeschlossene Laufzettel passen. Für das offizielle Datenblatt ist eine bewusste Auswahl erforderlich.</div></div>
        {% endfor %}
        {% set note_count = 0 %}
        {% for block in revision.blocks %}
            {% if block.type.value == 'editable_note' %}
                {% set note_count = note_count + 1 %}
                <div class="mb-3"><label class="form-label" for="datasheet-note-{{ block.stableKey }}">{{ block.label ?: 'Additional information' }}</label><textarea class="form-control" id="datasheet-note-{{ block.stableKey }}" name="notes[{{ block.stableKey }}]" rows="4" maxlength="10000">{{ submitted_notes[block.stableKey] is defined ? submitted_notes[block.stableKey] : block.text }}</textarea><div class="form-text">Dieser Text wird in der Vorschau und im freigegebenen Datenblatt verwendet und mit dessen Dokumentrevision gespeichert.</div></div>
            {% endif %}
        {% endfor %}
        {% if note_count == 0 %}<p class="text-muted">Diese Vorlage enthält keine beim Erstellen bearbeitbaren Notizfelder.</p>{% endif %}
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center"><strong>Additional notes</strong><button class="btn btn-sm btn-outline-success ms-auto" type="button" {{ stimulus_action('production/datasheet-additional-notes', 'add') }}><i class="fa-solid fa-plus fa-fw"></i> Add note</button></div>
            <div class="card-body" {{ stimulus_target('production/datasheet-additional-notes', 'list') }}>
                {% for note in additional_notes|default([]) %}
                    {% include 'production/datasheet/_additional_note.html.twig' with {note: note, note_index: loop.index0} %}
                {% endfor %}
            </div>
            <template {{ stimulus_target('production/datasheet-additional-notes', 'template') }}>
                {% include 'production/datasheet/_additional_note.html.twig' with {note: {title: '', text: '', width: 12}, note_index: null} %}
            </template>
            <div class="card-footer text-muted small">Optional notes are added only to this data sheet and are stored in its immutable source record. Plain text only; no HTML or program code is executed.</div>
        </div>
        <div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" type="submit" formnovalidate formtarget="_blank" formaction="{{ path('production_datasheet_instance_preview_pdf', {instance: instance.id, template: template.id}) }}"><i class="fa-solid fa-file-pdf fa-fw"></i> DRAFT-PDF ansehen</button><button class="btn btn-success" type="submit" {{ stimulus_action('production/datasheet-release', 'confirm', 'click') }}><i class="fa-solid fa-check fa-fw"></i> Offizielles Datenblatt freigeben</button></div>
    </form>

    <hr>
    <h5>Aufgelöste Datenquellen</h5>
    <p class="text-muted small">Fehlende Werte werden in der Vorschau als Strich dargestellt. Wenn mehrere abgeschlossene Laufzettel zu einer Quelle passen, weist die PDF ausdrücklich auf die notwendige Auswahl hin.</p>
    <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Output field</th><th>Resolved value</th></tr></thead><tbody>
        {% for item in datasheet_view.blocks %}
            {% if item.block.type.value == 'child_table' and not item.hidden %}
                {% for column in item.columns %}
                    <tr><td>{{ item.block.label }} · Spaltenüberschrift · {{ column.instance.displayIdentifier }}</td><td>{{ column.label }}{% if column.warning %}<div class="text-danger small"><i class="fa-solid fa-triangle-exclamation"></i> {{ {'Missing heading': 'Überschrift fehlt', 'Duplicate heading': 'Überschrift kommt mehrfach vor', 'Select an unambiguous source': 'Datenquelle bzw. Laufzettel eindeutig auswählen'}[column.warning] }}</div>{% endif %}</td></tr>
                {% endfor %}
            {% endif %}
            {% if item.block.type.value == 'value' %}<tr><td>{{ item.block.label }}</td><td>{{ item.value|default('–') }}</td></tr>{% endif %}
        {% else %}<tr><td colspan="2" class="text-muted">No mapped values.</td></tr>{% endfor %}
    </tbody></table></div>
{% endblock %}
