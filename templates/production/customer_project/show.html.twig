{% extends 'base.html.twig' %}
{% trans_default_domain 'production' %}

{% macro note_marker(notes) %}{% if notes %}<i class="fa-solid fa-note-sticky text-warning ms-1" title="{{ notes }}" aria-label="{{ 'production.project_position.has_notes'|trans }}"></i>{% endif %}{% endmacro %}

{% macro material_status(accessory, material_plan) %}
    {% if material_plan is null or not accessory.part %}
        <span class="text-muted">–</span>
    {% elseif not accessory.customerProject.productionSite %}
        <span class="badge bg-secondary" data-material-status="unknown">{{ 'production.material_plan.site_missing'|trans }}</span>
    {% else %}
        {% set item = material_plan.items|filter(item => item.part.id == accessory.part.id)|first %}
        {% if item %}
            <span class="badge {{ item.missing > 0 ? 'bg-danger' : 'bg-success' }}" data-material-status="{{ item.missing > 0 ? 'missing' : 'covered' }}"
                  title="{{ 'production.material_plan.order_part_breakdown'|trans({'%site%': accessory.customerProject.productionSite.fullPath, '%required%': item.required|number_format, '%available%': item.available|number_format, '%reserved%': item.reserved_covered_local|number_format, '%allocated%': item.allocated|number_format, '%consumed%': item.consumed|number_format}) }}">{% if item.missing > 0 %}{{ 'production.material_plan.order_part_missing'|trans({'%count%': item.missing|number_format}) }}{% else %}{{ 'production.material_plan.order_part_covered'|trans }}{% endif %}</span>
        {% else %}
            <span class="text-muted">–</span>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro position_rows(position, depth, number, build_status_class, material_plan) %}
    {% set indent = depth * 1.5 %}
    <tr data-production-position-row data-position-id="{{ position.id }}"{% if position.parent %} data-parent-id="{{ position.parent.id }}"{% endif %}{% if depth > 1 %} hidden{% endif %}>
        <td class="text-nowrap">{{ number }}</td>
        <td style="padding-left: {{ indent + 0.5 }}rem">
            {% if depth > 0 %}<i class="fa-solid fa-turn-up fa-rotate-90 text-muted fa-fw"></i>{% endif %}
            {% if position.children|length > 0 or position.partAssignments|length > 0 or (position.systemTemplate and position.slots|length > 0) %}
                <button type="button" class="btn btn-sm btn-link text-body p-0 me-1 production-position-toggle" data-production-position-toggle="{{ position.id }}" aria-expanded="{{ depth == 0 ? 'true' : 'false' }}" title="{{ 'production.project_position.toggle_children'|trans }}">
                    <i class="fa-solid fa-chevron-down fa-fw"></i>
                </button>
            {% endif %}
            <strong>{{ position.name }}</strong>
            {{ _self.note_marker(position.notes) }}
            {% if position.systemTemplate %}<span class="badge text-bg-light border">{{ 'production.system_template.label'|trans }}</span>{% endif %}
            {% if position.parent and not position.sourceSlot %}<span class="badge bg-warning text-dark">{{ 'production.project_position.detached_from_template'|trans }}</span>{% endif %}
        </td>
        <td>
            {% if position.systemTemplate and is_granted('@production_system_templates.read') %}
                <a href="{{ path('production_template_show', {id: position.systemTemplate.id}) }}">{{ position.contentName }}</a>
            {% elseif position.systemTemplate %}
                {{ position.contentName }}
            {% elseif position.templateProject %}
                <a href="{{ path('project_info', {id: position.templateProject.id}) }}">{{ position.contentName }}</a>
            {% elseif position.contentName %}
                <span class="text-muted">{{ position.contentName }} ({{ 'production.common.deleted_reference'|trans }})</span>
            {% endif %}
            {% if position.definition %}<i class="fa-solid fa-lock text-muted ms-1" title="{{ 'production.project_position.fixed_definition'|trans }}" aria-label="{{ 'production.project_position.fixed_definition'|trans }}"></i>{% endif %}
            {% if position.quantity > 1 %} × {{ position.quantity }}{% endif %}
        </td>
        <td class="text-center">
            {% if is_granted('@production_build_instances.read') %}
            {% for instance in position.buildInstances|filter(instance => is_granted('read', instance)) %}
                <span class="badge {{ build_status_class[instance.status.value]|default('bg-secondary') }}" title="{{ instance.displayIdentifier }}">{{ ('production.build_instance.status.' ~ instance.status.value)|trans }}</span>
            {% else %}
                <span class="text-muted">–</span>
            {% endfor %}
            {% else %}<span class="text-muted">–</span>{% endif %}
        </td>
        <td class="text-center">
            {% if is_granted('@production_build_instances.read') %}
            {% for instance in position.buildInstances|filter(instance => is_granted('read', instance)) %}
                <span class="d-inline-block text-nowrap" data-order-instance="{{ instance.id }}"><a class="badge text-bg-light border text-decoration-none" href="{{ path('production_build_instance_show', {id: instance.id}) }}">{{ instance.displayIdentifier }}</a>{{ _self.note_marker(instance.notes) }}</span>
            {% else %}
                {% if is_granted('@production_orders.edit') and is_granted('@production_build_instances.assign') and position.customerProject.status.value == 'in_production' and (position.systemTemplate or position.templateProject) %}
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('production_project_position_assign_instance', {id: position.id}) }}"><i class="fa-solid fa-link fa-fw"></i> {{ 'production.build_instance.assign'|trans }}</a>
                {% else %}
                    <span class="text-muted">{{ 'production.build_instance.position_unassigned'|trans }} (0 / {{ position.quantity }})</span>
                {% endif %}
            {% endfor %}
            {% else %}<span class="text-muted">–</span>{% endif %}
        </td>
        <td class="text-end text-nowrap">
            {% if is_granted('@production_orders.edit') %}
                {% if position.systemTemplate %}<a class="btn btn-sm btn-outline-warning" href="{{ path('production_project_position_configure', {id: position.id}) }}" title="{{ 'production.project_position.configure'|trans }}"><i class="fa-solid fa-sliders fa-fw"></i></a>{% endif %}
                {% if is_granted('@production_build_instances.build') and position.buildInstances is empty and position.customerProject.status.value == 'in_production' and (position.systemTemplate or position.templateProject) %}
                    <a class="btn btn-sm btn-success" href="{{ path('production_project_position_build', {id: position.id}) }}"><i class="fa-solid fa-hammer fa-fw"></i> {{ 'production.project_position.build'|trans }}</a>
                {% elseif is_granted('@production_build_instances.assign') and position.buildInstances is not empty %}
                    {% for instance in position.buildInstances|filter(instance => is_granted('read', instance)) %}
                        <form method="post" action="{{ path('production_build_instance_unassign', {id: instance.id}) }}" class="d-inline"
                              {{ stimulus_controller('elements/delete_btn') }} {{ stimulus_action('elements/delete_btn', 'submit', 'submit') }}
                              data-delete-title="{{ 'production.action.confirm_title'|trans }}"
                              data-delete-message="{{ 'production.build_instance.unassign_confirm'|trans({'%serial%': instance.displayIdentifier}) }}"
                              data-delete-message-text>
                            <input type="hidden" name="_token" value="{{ csrf_token('unassign_build_instance_' ~ instance.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="{{ 'production.build_instance.unassign'|trans }}"><i class="fa-solid fa-link-slash fa-fw"></i> {{ 'production.build_instance.unassign'|trans }}</button>
                        </form>
                    {% endfor %}
                {% endif %}
                <a class="btn btn-sm btn-outline-primary" href="{{ path('production_project_position_edit', {id: position.id}) }}"><i class="fa-solid fa-pen fa-fw"></i></a>
                <form method="post" action="{{ path('production_project_position_delete', {id: position.id}) }}" class="d-inline"
                      {{ stimulus_controller('elements/delete_btn') }} {{ stimulus_action('elements/delete_btn', 'submit', 'submit') }}
                      data-delete-title="{{ 'production.action.confirm_title'|trans }}"
                      data-delete-message="{{ 'production.project_position.delete_confirm'|trans({'%name%': position.name}) }}"
                      data-delete-message-text>
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_project_position_' ~ position.id) }}">
                    <button class="btn btn-sm btn-outline-danger" title="{{ 'production.project_position.delete'|trans }}"><i class="fa-solid fa-trash fa-fw"></i></button>
                </form>
            {% endif %}
        </td>
    </tr>

    {% if position.systemTemplate %}
        {% for slot in position.slots %}
            {% set assignments = position.getAssignmentsForSlot(slot) %}
            {% set part_assignment = position.getPartAssignmentForSlot(slot) %}
            {% set slot_offset = position.getDisplayOffsetForSlot(slot) %}
            {% set slot_choice_count = slot.allowedSystemTemplates|length + slot.allowedProjects|length + slot.allowedParts|length %}
            {% if assignments is not empty %}
                {% for child in assignments %}
                    {{ _self.position_rows(child, depth + 1, number ~ '.' ~ (slot_offset + loop.index0), build_status_class, material_plan) }}
                {% endfor %}
            {% elseif part_assignment %}
                <tr data-production-position-row data-parent-id="{{ position.id }}"{% if depth > 0 %} hidden{% endif %}>
                    <td class="text-nowrap">{{ number }}.{{ slot_offset }}</td>
                    <td style="padding-left: {{ indent + 2 }}rem"><i class="fa-solid fa-turn-up fa-rotate-90 text-muted fa-fw me-1"></i><strong>{{ slot.name }}</strong></td>
                    <td>{% if part_assignment.part %}<a href="{{ path('part_info', {id: part_assignment.part.id}) }}">{{ part_assignment.part.name }}</a>{% else %}<span class="text-muted">{{ part_assignment.partName }} ({{ 'production.common.deleted_reference'|trans }})</span>{% endif %} × {{ part_assignment.quantity }}{{ _self.note_marker(part_assignment.note) }}{% if part_assignment.serialTracking %} <span class="badge bg-info text-dark"><i class="fa-solid fa-barcode fa-fw"></i></span>{% endif %}</td>
                    <td class="text-center">{{ _self.material_status(part_assignment, material_plan) }}</td>
                    <td class="text-center">–</td><td></td>
                </tr>
            {% else %}
                <tr class="table-light" data-production-position-row data-parent-id="{{ position.id }}"{% if depth > 0 %} hidden{% endif %}>
                    <td class="text-nowrap">{{ number }}.{{ slot_offset }}</td>
                    <td style="padding-left: {{ indent + 2 }}rem"><i class="fa-solid fa-turn-up fa-rotate-90 text-muted fa-fw me-1"></i>{{ slot.name }}</td>
                    <td>
                        {% if slot.required and slot_choice_count > 1 %}
                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-list-check fa-fw"></i> {{ 'production.project_position.slot.choice_required'|trans }}</span>
                            <span class="text-muted small">{{ 'production.project_position.slot.choice_count'|trans({'%count%': slot_choice_count}) }}</span>
                        {% else %}
                            <span class="text-muted">{{ 'production.project_position.slot.empty'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="text-center">{% if slot.required and slot_choice_count > 1 %}<span class="badge bg-warning text-dark">{{ 'production.project_position.slot.choose'|trans }}</span>{% elseif slot.required %}<span class="badge bg-danger">{{ 'production.system_template.slot.required'|trans }}</span>{% else %}<span class="badge bg-secondary">{{ 'production.system_template.slot.optional'|trans }}</span>{% endif %}</td>
                    <td class="text-center">–</td><td></td>
                </tr>
            {% endif %}
        {% endfor %}

        {% set detached_offset = position.nextDisplayOffset %}
        {% for child in position.children|filter(child => child.sourceSlot is null) %}
            {{ _self.position_rows(child, depth + 1, number ~ '.' ~ (detached_offset + loop.index0), build_status_class, material_plan) }}
        {% endfor %}
        {% set detached_position_count = position.children|filter(child => child.sourceSlot is null)|length %}
        {% for part_assignment in position.partAssignments|filter(assignment => assignment.sourceSlot is null) %}
            <tr class="table-warning" data-production-position-row data-parent-id="{{ position.id }}"{% if depth > 0 %} hidden{% endif %}>
                <td class="text-nowrap">{{ number }}.{{ detached_offset + detached_position_count + loop.index0 }}</td>
                <td style="padding-left: {{ indent + 2 }}rem"><i class="fa-solid fa-turn-up fa-rotate-90 text-muted fa-fw me-1"></i><span class="badge bg-warning text-dark">{{ 'production.project_position.detached_from_template'|trans }}</span></td>
                <td>{% if part_assignment.part %}<a href="{{ path('part_info', {id: part_assignment.part.id}) }}">{{ part_assignment.part.name }}</a>{% else %}<span class="text-muted">{{ part_assignment.partName }} ({{ 'production.common.deleted_reference'|trans }})</span>{% endif %} × {{ part_assignment.quantity }}{{ _self.note_marker(part_assignment.note) }}{% if part_assignment.serialTracking %} <span class="badge bg-info text-dark"><i class="fa-solid fa-barcode fa-fw"></i></span>{% endif %}</td>
                <td class="text-center">{{ _self.material_status(part_assignment, material_plan) }}</td>
                <td class="text-center">–</td><td class="text-end">{% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('production_accessory_edit', {id: part_assignment.id}) }}" title="{{ 'production.accessory.edit'|trans }}"><i class="fa-solid fa-pen fa-fw"></i></a>{% endif %}</td>
            </tr>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% set status_class = {planning: 'bg-secondary', commissioned: 'bg-info text-dark', in_production: 'bg-primary', completed: 'bg-success', delivered: 'bg-success', cancelled: 'bg-danger'} %}
{% set build_status_class = {planned: 'bg-secondary', in_progress: 'bg-primary', completed: 'bg-success', installed: 'bg-success', scrapped: 'bg-danger'} %}
{% set workflow = ['planning', 'commissioned', 'in_production', 'completed', 'delivered'] %}
{% set status_step = {planning: 0, commissioned: 1, in_production: 2, completed: 3, delivered: 4} %}
{% set current_step = status_step[project.status.value]|default(0) %}

{% block title %}{{ 'production.customer_project.label'|trans }} {{ project.projectNumber }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .production-position-toggle .fa-chevron-down { transition: transform .15s ease-in-out; }
        .production-position-toggle[aria-expanded="false"] .fa-chevron-down { transform: rotate(-90deg); }
        .production-project-users { transform: translateY(.25rem); }
    </style>
{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h2 mb-0">{{ 'production.customer_project.label'|trans }} {{ project.projectNumber }}</h1>
                {% if project.assignedUsers|length > 0 %}
                    <div class="d-flex flex-wrap align-items-center gap-1 production-project-users">
                        {% for assigned_user in project.assignedUsers %}
                            <span class="badge text-bg-light border fw-normal" title="@{{ assigned_user.name }}"><i class="fa-solid fa-user fa-fw text-muted"></i> {{ assigned_user.fullName ?: assigned_user.name }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div class="d-flex align-items-center gap-2 mt-1"><span class="fs-5">{{ project.name }}</span><span class="badge {{ status_class[project.status.value]|default('bg-secondary') }}">{{ ('production.customer_project.status.' ~ project.status.value)|trans }}</span></div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('production_customer_project_index') }}"><i class="fa-solid fa-arrow-left fa-fw"></i> {{ 'production.customer_project.plural'|trans }}</a>
            {% if is_granted('@production_material.reserve') and project.status.value in ['commissioned', 'in_production'] %}<a class="btn btn-outline-warning" href="{{ path('production_material_reservation', {id: project.id}) }}"><i class="fa-solid fa-bookmark fa-fw"></i> Material reservieren</a>{% endif %}
            {% if is_granted('@production_orders.edit') %}
                <a class="btn btn-primary" href="{{ path('production_customer_project_edit', {id: project.id}) }}"><i class="fa-solid fa-pen fa-fw"></i> {{ 'production.action.edit'|trans }}</a>
            {% endif %}
        </div>
    </div>

    {% if project.customerReference %}<div class="mb-3 text-break" data-order-customer-reference><strong>{{ 'production.customer_project.customer_reference'|trans }}:</strong> {{ project.customerReference }}</div>{% endif %}

    {% if project.description %}<div class="alert alert-light border mb-3 text-break" data-order-description>{{ project.description|nl2br }}</div>{% endif %}

    {% if project.status.value == 'cancelled' %}<div class="alert alert-danger"><i class="fa-solid fa-ban fa-fw"></i> {{ 'production.project.cancelled_hint'|trans }}</div>{% else %}
        <div class="card mb-3" data-order-workflow><div class="card-body py-3"><div class="row g-2 text-center">{% for state in workflow %}<div class="col"><div class="border rounded py-2 {{ loop.index0 <= current_step ? 'border-primary text-primary fw-bold bg-primary-subtle' : 'text-muted' }}"><span class="badge rounded-pill {{ loop.index0 <= current_step ? 'bg-primary' : 'bg-secondary' }} me-1">{{ loop.index }}</span>{{ ('production.customer_project.status.' ~ state)|trans }}</div></div>{% endfor %}</div></div></div>
    {% endif %}

    <div class="row g-3 mb-3">
        <div class="col-md" data-order-summary="project"><div class="card h-100"><div class="card-body d-flex gap-3 align-items-center"><i class="fa-solid fa-diagram-project fa-2x text-primary"></i><div><small class="text-muted">{{ 'production.project.label'|trans }}</small><div class="fw-bold">{% if is_granted('@production_projects.read') %}<a href="{{ path('production_project_show', {id: project.productionProject.id}) }}">{{ project.productionProject }}</a>{% else %}{{ project.productionProject }}{% endif %}</div></div></div></div></div>
        <div class="col-md" data-order-summary="customer"><div class="card h-100"><div class="card-body d-flex gap-3 align-items-center"><i class="fa-solid fa-building fa-2x text-primary"></i><div><small class="text-muted">{{ 'production.customer.label'|trans }}</small><div class="fw-bold">{% if is_granted('@production_customers.read') %}<a href="{{ path('production_customer_show', {id: project.customer.id}) }}">{{ project.customer.name }}</a>{% else %}{{ project.customer.name }}{% endif %}</div></div></div></div></div>
        <div class="col-md" data-order-summary="planned-delivery"><div class="card h-100"><div class="card-body d-flex gap-3 align-items-center"><i class="fa-solid fa-calendar-check fa-2x text-primary"></i><div><small class="text-muted">{{ 'production.customer_project.planned_delivery_date'|trans }}</small><div class="fw-bold">{{ project.plannedDeliveryDate ? project.plannedDeliveryDate|format_date('medium') : ('production.customer_project.delivery_date_unset'|trans) }}</div></div></div></div></div>
        <div class="col-md" data-order-summary="systems"><div class="card h-100"><div class="card-body d-flex gap-3 align-items-center"><i class="fa-solid fa-microchip fa-2x text-primary"></i><div><small class="text-muted">{{ 'production.project_position.systems'|trans }}</small><div class="fw-bold">{{ project.rootPositions|length }}</div></div></div></div></div>
        <div class="col-md" data-order-summary="build-instances"><div class="card h-100"><div class="card-body d-flex gap-3 align-items-center"><i class="fa-solid fa-layer-group fa-2x text-primary"></i><div><small class="text-muted">{{ 'production.build_instance.plural'|trans }}</small><div class="fw-bold">{{ is_granted('@production_build_instances.read') ? project.buildInstances|filter(instance => is_granted('read', instance))|length : '–' }}</div></div></div></div></div>
    </div>

    <div class="card mb-3" data-order-section="positions">
        <div class="card-header d-flex justify-content-between align-items-center"><strong><i class="fa-solid fa-list-check fa-fw"></i> {{ 'production.project_position.plural'|trans }}</strong>{% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-success" href="{{ path('production_project_position_new', {id: project.id}) }}"><i class="fa-solid fa-plus fa-fw"></i> {{ 'production.project_position.add_system'|trans }}</a>{% endif %}</div>
        <div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle" data-production-position-tree><thead><tr><th>#</th><th>{{ 'production.common.name'|trans }}</th><th>{{ 'production.project_position.content'|trans }}</th><th class="text-center">{{ 'production.common.status'|trans }}</th><th class="text-center">{{ 'production.build_instance.plural'|trans }}</th><th></th></tr></thead><tbody>
        {% for position in project.rootPositions %}{{ _self.position_rows(position, 0, position.position, build_status_class, material_plan) }}{% endfor %}
        {% for line in project.unassignedImportLines %}
            <tr data-import-line="{{ line.id }}">
                <td>PDF {{ line.lineNumber }}</td>
                <td><strong>{{ line.description }}</strong>{{ _self.note_marker(line.notes) }}<div class="small text-muted">{{ line.quantity }} {{ line.unitLabel }}</div></td>
                <td>{{ ('production.import_line.' ~ line.disposition.value ~ '_help')|trans }}</td>
                <td class="text-center"><span class="badge {{ line.disposition.value == 'pending' ? 'bg-warning text-dark' : 'bg-secondary' }}">{{ ('production.import_line.' ~ line.disposition.value)|trans }}</span></td>
                <td class="text-center">–</td>
                <td class="text-end">
                {% if is_granted('@production_orders.edit') and project.status.value not in ['completed', 'delivered', 'cancelled'] %}
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('production_import_line_assign', {id: line.id}) }}">{{ 'production.import_line.assign'|trans }}</a>
                    {% set action = line.disposition.value == 'pending' ? 'note' : 'pending' %}
                    <form class="d-inline" method="post" action="{{ path('production_import_line_classify', {id: line.id, action: action}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('import_line_' ~ line.id ~ '_' ~ action) }}">
                        <input type="hidden" name="expected" value="{{ line.disposition.value }}">
                        <button class="btn btn-sm btn-outline-primary" type="submit">{{ ('production.import_line.mark_' ~ action)|trans }}</button>
                    </form>
                {% endif %}
                </td>
            </tr>
        {% endfor %}
        {% if project.rootPositions is empty and project.unassignedImportLines is empty %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'production.project_position.empty'|trans }}</td></tr>{% endif %}
        </tbody></table></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-6" data-order-section="accessories"><div class="card h-100"><div class="card-header d-flex justify-content-between align-items-center"><strong><i class="fa-solid fa-box-open fa-fw"></i> {{ 'production.accessory.plural'|trans }}</strong>{% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-success" href="{{ path('production_accessory_new', {id: project.id}) }}"><i class="fa-solid fa-plus fa-fw"></i> {{ 'production.accessory.new'|trans }}</a>{% endif %}</div><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle"><thead><tr><th>{{ 'production.accessory.part'|trans }}</th><th>{{ 'production.accessory.quantity'|trans }}</th><th>{{ 'production.material_plan.label'|trans }}</th><th></th></tr></thead><tbody>
            {% for accessory in project.accessories|filter(a => a.projectPosition is null) %}<tr data-accessory-id="{{ accessory.id }}"><td>{% if accessory.part %}<a href="{{ path('part_info', {id: accessory.part.id}) }}">{{ accessory.part.name }}</a>{% else %}<span class="text-muted">{{ accessory.partName }} ({{ 'production.common.deleted_reference'|trans }})</span>{% endif %}{{ _self.note_marker(accessory.note) }}</td><td>{{ accessory.quantity }}</td><td>{{ _self.material_status(accessory, material_plan) }}</td><td class="text-end">{% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('production_accessory_edit', {id: accessory.id}) }}"><i class="fa-solid fa-pen fa-fw"></i></a>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'production.accessory.empty'|trans }}</td></tr>{% endfor %}
        </tbody></table></div></div></div>

        <div class="col-xl-6" data-order-section="notes">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong><i class="fa-solid fa-note-sticky fa-fw"></i> {{ 'production.common.notes'|trans }}</strong>
                    {% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('production_customer_project_edit', {id: project.id}) }}" title="{{ 'production.action.edit'|trans }}"><i class="fa-solid fa-pen fa-fw"></i></a>{% endif %}
                </div>
                <div class="card-body">
                    {% if project.notes %}{{ project.notes|nl2br }}{% else %}<span class="text-muted">{{ 'production.common.no_notes'|trans }}</span>{% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if is_granted('@production_material.read') %}
    {% if project.status.value in ['commissioned', 'in_production'] and material_plan.items is not empty %}
        {% if not project.productionSite %}<div class="alert alert-secondary d-flex justify-content-between align-items-center py-2"><span><i class="fa-solid fa-location-dot fa-fw"></i> Ohne Fertigungsstandort ist keine standortbezogene Materialaussage möglich.</span>{% if is_granted('@production_orders.edit') %}<a class="btn btn-sm btn-outline-secondary" href="{{ path('production_customer_project_edit', {id: project.id}) }}">Standort festlegen</a>{% endif %}</div>{% elseif material_plan.reservation_conflict %}<div class="alert alert-danger py-2"><i class="fa-solid fa-triangle-exclamation fa-fw"></i> Mindestens eine Reservierung ist durch eine zwischenzeitliche Bestandsänderung nicht mehr vollständig gedeckt. Bitte die Reservierung prüfen und aktualisieren.</div>{% elseif material_plan.reservation_stale %}<div class="alert alert-warning py-2"><i class="fa-solid fa-arrows-rotate fa-fw"></i> Bedarf und Reservierung stimmen nicht überein. Die BOM oder Projektkonfiguration wurde geändert oder Material ist noch nicht reserviert.</div>{% elseif material_plan.remote_reserved_total > 0 %}<div class="alert alert-warning py-2"><i class="fa-solid fa-truck fa-fw"></i> {{ material_plan.remote_reserved_total }} Teile sind an einem anderen Standort reserviert und warten noch auf den Transfer nach {{ project.productionSite.fullPath }}.</div>{% else %}<div class="alert alert-success py-2"><i class="fa-solid fa-bookmark fa-fw"></i> Der noch offene Materialbedarf ist vollständig reserviert. Der Part-DB-Bestand wird erst beim Bereitstellen oder Bauen verändert.</div>{% endif %}
    {% endif %}

    <div class="card mb-3" data-order-section="material">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong><i class="fa-solid fa-boxes-stacked fa-fw"></i> {{ 'production.material_plan.label'|trans }}</strong>
            {% if not project.productionSite %}
                <span class="badge bg-secondary"><i class="fa-solid fa-location-dot fa-fw"></i> {{ 'production.material_plan.site_missing'|trans }}</span>
            {% elseif not material_plan.configuration_complete %}
                <span class="badge bg-secondary">{{ 'production.material_plan.not_configured'|trans }}</span>
            {% elseif not material_plan.complete %}
                <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation fa-fw"></i> {{ 'production.material_plan.incomplete'|trans }}</span>
            {% elseif material_plan.fully_reserved %}
                <span class="badge bg-primary"><i class="fa-solid fa-bookmark fa-fw"></i> {{ 'production.material_plan.secured_status'|trans }}</span>
            {% else %}
                <span class="badge bg-success"><i class="fa-solid fa-check fa-fw"></i> {{ 'production.material_plan.available_status'|trans }}</span>
            {% endif %}
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle"><thead><tr><th>{{ 'production.material_plan.part'|trans }}</th><th class="text-center">{{ 'production.material_plan.required'|trans }}</th><th class="text-center">{{ 'production.material_plan.secured'|trans }}</th><th class="text-center">{{ 'production.material_plan.installed'|trans }}</th><th class="text-center">{{ 'production.material_plan.missing'|trans }}</th><th></th></tr></thead><tbody>
        {% for item in material_plan.items %}<tr><td><a href="{{ path('part_info', {id: item.part.id}) }}">{{ item.part.name }}</a>{% if item.reservation_stale %} <i class="fa-solid fa-arrows-rotate text-warning" title="{{ 'production.material_plan.reconcile_reservation'|trans }}"></i>{% endif %}</td><td class="text-center">{{ item.required|number_format }}</td><td class="text-center" title="{{ 'production.material_plan.secured_breakdown'|trans({'%reserved%': item.reserved|number_format, '%allocated%': item.allocated|number_format}) }}">{{ item.secured|number_format }}{% for remote in item.remote_reservations %}<div><span class="badge bg-warning text-dark fw-normal"><i class="fa-solid fa-truck fa-fw"></i> {{ remote.quantity }} · {{ remote.location ? remote.location.fullPath : 'anderer Standort' }}</span></div>{% endfor %}</td><td class="text-center">{{ item.consumed|number_format }}</td><td class="text-center">{% if not project.productionSite %}<span class="text-muted">–</span>{% elseif item.missing > 0 %}<span class="badge bg-danger">{{ item.missing|number_format }}</span>{% else %}<span class="badge bg-success">0</span>{% endif %}</td><td class="text-end">{% if project.status.value == 'in_production' and item.remaining > 0 and is_granted('@production_orders.edit') and is_granted('@production_material.provide') and is_granted('@parts_stock.withdraw') %}<a class="btn btn-sm btn-primary" href="{{ path('production_material_allocate', {project: project.id, part: item.part.id}) }}"><i class="fa-solid fa-arrow-right-arrow-left fa-fw"></i> {{ 'production.material_plan.provide'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'production.material_plan.empty'|trans }}</td></tr>{% endfor %}
        </tbody></table></div>
    </div>
    {% endif %}

    <div class="row g-3">
        {% if is_granted('@production_build_instances.read') %}<div class="col-xl-6" data-order-section="build-instances"><div class="card h-100"><div class="card-header d-flex justify-content-between align-items-center"><strong><i class="fa-solid fa-layer-group fa-fw"></i> {{ 'production.project.build_instances'|trans }}</strong><a class="btn btn-sm btn-outline-primary" href="{{ path('production_build_instance_index') }}">{{ 'production.action.show_all'|trans }}</a></div><div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle" data-order-build-instances-table><thead><tr><th>{{ 'production.build_instance.serial_number'|trans }}</th><th>{{ 'production.build_instance.template'|trans }}</th><th class="text-center">{{ 'production.common.status'|trans }}</th><th class="text-center">{{ 'production.project_position.label'|trans }}</th></tr></thead><tbody>
            {% for instance in project.buildInstances|filter(instance => is_granted('read', instance)) %}<tr data-order-instance="{{ instance.id }}"><td><a href="{{ path('production_build_instance_show', {id: instance.id}) }}"><strong>{{ instance.displayIdentifier }}</strong></a>{{ _self.note_marker(instance.notes) }}</td><td>{{ instance.contentName }}{% if not instance.systemTemplate and not instance.templateProject %} <span class="text-muted">({{ 'production.common.deleted_reference'|trans }})</span>{% endif %}</td><td class="text-center"><span class="badge {{ build_status_class[instance.status.value]|default('bg-secondary') }}">{{ ('production.build_instance.status.' ~ instance.status.value)|trans }}</span></td><td class="text-center">{{ instance.projectPosition ? instance.projectPosition.name : '–' }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'production.common.empty'|trans }}</td></tr>{% endfor %}
        </tbody></table></div></div></div>{% endif %}

        <div class="col-xl-6" data-order-section="attachments">
            <div class="card h-100">
                <div class="card-header"><strong><i class="fa-solid fa-paperclip fa-fw"></i> Dateianhänge</strong></div>
                <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Datei</th><th>Größe</th><th>Hinzugefügt</th><th></th></tr></thead><tbody>
                {% for attachment in project.attachments %}<tr><td><a href="{{ path('production_order_attachment_download', {id: attachment.id}) }}" data-turbo="false" data-turbo-frame="_top" download><i class="fa-solid fa-download fa-fw"></i> {{ attachment.originalFilename }}</a></td><td>{{ (attachment.fileSize / 1024)|number_format(1, ',', '.') }} KB</td><td>{{ attachment.addedDate|format_datetime('short', 'short') }}</td><td class="text-end">{% if is_granted('@production_orders.edit') %}<form method="post" action="{{ path('production_order_attachment_delete', {id: attachment.id}) }}" {{ stimulus_controller('elements/delete_btn') }} {{ stimulus_action('elements/delete_btn', 'submit', 'submit') }} data-delete-title="{{ 'production.action.confirm_title'|trans }}" data-delete-message="{{ 'production.customer_project.attachment_delete_confirm'|trans }}" data-delete-message-text><input type="hidden" name="_token" value="{{ csrf_token('delete_order_attachment_' ~ attachment.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="fa-solid fa-trash fa-fw"></i></button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">Noch keine Dateien angehängt.</td></tr>{% endfor %}
                </tbody></table></div>
                {% if is_granted('@production_orders.edit') %}<div class="card-footer"><form class="d-flex gap-2" method="post" enctype="multipart/form-data" action="{{ path('production_order_attachment_upload', {id: project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('production_order_attachment_' ~ project.id) }}"><input class="form-control form-control-sm" type="file" name="attachment" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.csv,.docx,.xlsx,.odt,.ods,.eml" required><button class="btn btn-sm btn-success text-nowrap" type="submit"><i class="fa-solid fa-upload fa-fw"></i> Datei anhängen</button></form><div class="form-text">Erlaubt: PDF, Bilder, Text/CSV, DOCX/XLSX, ODT/ODS und EML. Maximal {{ max_attachment_size|format_bytes }} je Datei gemäß Part-DB-Einstellung und 250 MB je Auftrag. Downloads sind nur mit Auftragsberechtigung möglich.</div></div>{% endif %}
            </div>
        </div>
    </div>

    <script src="{{ asset('js/production/tree_toggle.js') }}"></script>
{% endblock %}
