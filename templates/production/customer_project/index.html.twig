{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% set page_title = title|default('production.customer_project.plural') %}
{% block title %}{{ page_title|trans }}{% endblock %}
{% block card_title %}<i class="fa-solid {{ my_projects|default(false) ? 'fa-user-check' : 'fa-folder-open' }} fa-fw"></i> {{ page_title|trans }}{% endblock %}

{% block card_content %}
    <div class="d-flex justify-content-between mb-2">
        <div class="d-flex gap-2">
            {% if my_projects|default(false) %}
                <a href="{{ path('production_customer_project_index') }}" class="btn btn-outline-primary"><i class="fa-solid fa-folder-open fa-fw"></i> {{ 'production.customer_project.all_projects'|trans }}</a>
            {% endif %}
        </div>
        {% if not my_projects|default(false) %}
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                {% if is_granted('@production_orders.import') %}<a href="{{ path('production_order_import') }}" class="btn btn-outline-success text-nowrap"><i class="fa-solid fa-file-import fa-fw"></i> Auftrag aus PDF importieren</a>{% endif %}
                {% if is_granted('@production_orders.create') %}<a href="{{ path('production_customer_project_new') }}" class="btn btn-success text-nowrap"><i class="fa-solid fa-plus fa-fw"></i> {{ 'production.customer_project.new'|trans }}</a>{% endif %}
            </div>
        {% endif %}
    </div>

    {% include 'production/_list_datatable.html.twig' with {
        datatable: datatable,
        state_tag: my_projects|default(false) ? 'production_my_orders_v3' : 'production_orders_v3',
        filter_id: my_projects|default(false) ? 'my-order' : 'order',
        filter_route: my_projects|default(false) ? 'production_customer_project_mine' : 'production_customer_project_index',
        active_label: my_projects|default(false) ? 'In Produktion' : 'Aktive Aufträge',
        search_placeholder: 'Auftragsnummer, Projektnummer oder Kunde',
        status_options: project_statuses|default([]),
        status_translation_prefix: 'production.customer_project.status.',
        filters_open: filters_open|default(false), search_query: search_query|default(null),
        selected_status_filter: selected_status_filter|default('active'),
        selected_customer: selected_customer|default(null), selected_year: selected_year|default(null),
        customers: customers|default([])
    } only %}
{% endblock %}
