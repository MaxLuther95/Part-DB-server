{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ 'production.build_instance.plural'|trans }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-screwdriver-wrench fa-fw"></i> {{ 'production.build_instance.plural'|trans }}{% endblock %}

{% block card_content %}
    <div class="d-flex justify-content-end mb-2">
        {% if is_granted('@production_build_instances.build') %}<a href="{{ path('production_build') }}" class="btn btn-success"><i class="fa-solid fa-hammer fa-fw"></i> {{ 'production.navigation.build'|trans }}</a>{% endif %}
    </div>
    {% include 'production/_list_datatable.html.twig' with {
        datatable: datatable, state_tag: 'production_build_instances_v3',
        filter_id: 'build', filter_route: 'production_build_instance_index', active_label: 'Aktive Geräte', search_placeholder: 'Seriennummer, System oder Bauprojekt',
        status_options: build_statuses, status_translation_prefix: 'production.build_instance.status.',
        filters_open: filters_open, search_query: search_query, selected_status_filter: selected_status_filter,
        selected_customer: selected_customer, selected_year: selected_year, customers: customers
    } only %}
{% endblock %}
