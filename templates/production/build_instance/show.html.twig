{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ build_instance.displayIdentifier }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-screwdriver-wrench fa-fw"></i> {{ build_instance.displayIdentifier }}{% endblock %}

{% block card_content %}
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="{{ path('production_build_instance_index') }}"><i class="fa-solid fa-arrow-left fa-fw"></i> {{ 'production.build_instance.plural'|trans }}</a>
        {% if is_granted('@production_build_instances.edit') %}
            <a class="btn btn-primary" href="{{ path('production_build_instance_edit', {id: build_instance.id}) }}"><i class="fa-solid fa-pen fa-fw"></i> {{ 'production.action.edit'|trans }}</a>
        {% endif %}
    </div>
    <dl class="row">
        <dt class="col-sm-3">{{ 'production.build_instance.serial_number'|trans }}</dt><dd class="col-sm-9"><strong>{{ build_instance.serialNumber ?: '–' }}</strong></dd>
        <dt class="col-sm-3">{{ 'production.build_instance.template'|trans }}</dt><dd class="col-sm-9">{% if build_instance.systemTemplate and is_granted('@production_system_templates.read') %}<a href="{{ path('production_template_show', {id: build_instance.systemTemplate.id}) }}">{{ build_instance.systemTemplate.name }}</a>{% elseif build_instance.systemTemplate %}{{ build_instance.systemTemplate.name }}{% elseif build_instance.templateProject %}<a href="{{ path('project_info', {id: build_instance.templateProject.id}) }}">{{ build_instance.templateProject.fullPath }}</a>{% else %}<span class="text-muted">{{ build_instance.contentName }} ({{ 'production.common.deleted_reference'|trans }})</span>{% endif %}</dd>
        <dt class="col-sm-3">{{ 'production.common.status'|trans }}</dt><dd class="col-sm-9"><span class="badge bg-secondary">{{ ('production.build_instance.status.' ~ build_instance.status.value)|trans }}</span></dd>
        <dt class="col-sm-3">{{ 'production.build_instance.location'|trans }}</dt><dd class="col-sm-9">{{ build_instance.location|default('–') }}</dd>
        <dt class="col-sm-3">{{ 'production.customer_project.label'|trans }}</dt><dd class="col-sm-9">{% if build_instance.customerProject and is_granted('@production_orders.read') %}<a href="{{ path('production_customer_project_show', {id: build_instance.customerProject.id}) }}">{{ build_instance.customerProject }}</a>{% elseif build_instance.customerProject %}{{ build_instance.customerProject }}{% else %}{{ 'production.build_instance.unassigned'|trans }}{% endif %}</dd>
        <dt class="col-sm-3">{{ 'production.project_position.label'|trans }}</dt><dd class="col-sm-9">{{ build_instance.projectPosition ? build_instance.projectPosition.name : '–' }}</dd>
        <dt class="col-sm-3">{{ 'production.build_instance.notes'|trans }}</dt><dd class="col-sm-9">{{ build_instance.notes ? build_instance.notes|nl2br : '–' }}</dd>
        <dt class="col-sm-3">{{ 'production.common.created_at'|trans }}</dt><dd class="col-sm-9">{{ build_instance.addedDate ? build_instance.addedDate|format_datetime('short', 'short') : '–' }}</dd>
        <dt class="col-sm-3">{{ 'production.build_instance.completed_at'|trans }}</dt><dd class="col-sm-9">{{ build_instance.completedAt ? build_instance.completedAt|format_datetime('short', 'short') : '–' }}</dd>
    </dl>
    {% if build_instance.children|length > 0 %}<h5>Untergeordnete Geräte und Baugruppen</h5><div class="list-group mb-4">{% for child in build_instance.children %}<a class="list-group-item list-group-item-action" href="{{ path('production_build_instance_show', {id: child.id}) }}">{% if child.installedSlot %}<span class="badge text-bg-light border me-2">{{ child.installedSlot.name }}{% if child.installedSlot.maxQuantity > 1 and child.installedSlotIndex is not null %} {{ child.installedSlotIndex + 1 }}{% endif %}</span>{% endif %}<strong>{{ child.displayIdentifier }}</strong> · {{ child.contentName }}</a>{% endfor %}</div>{% endif %}
    {% if is_granted('@production_protocols.read') %}
        <div class="d-flex align-items-center mt-4 mb-2"><h5 class="mb-0"><i class="fa-solid fa-list-check fa-fw"></i> Laufzettel und Messprotokolle</h5>{% if is_granted('@production_protocol_templates.read') %}<a class="btn btn-sm btn-outline-secondary ms-auto" href="{{ path('production_protocol_template_index') }}">Vorlagen verwalten</a>{% endif %}</div>
        <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Vorlage</th><th>Nummer</th><th>Status</th><th>Bearbeitet</th><th></th></tr></thead><tbody>
            {% for run in build_instance.protocolRuns %}
                <tr><td>{{ run.revision.template.name }} <small class="text-muted">v{{ run.revision.revisionNumber }}</small></td><td>#{{ run.runNumber }}</td><td><span class="badge {{ run.status.value == 'completed' ? 'text-bg-success' : (run.status.value == 'invalid' ? 'text-bg-danger' : 'text-bg-warning') }}">{{ ('production.protocol.run_status.' ~ run.status.value)|trans }}</span></td><td>{{ run.lastModified ? run.lastModified|format_datetime('short', 'short') : '–' }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path(run.status.value == 'draft' and is_granted('@production_protocols.edit') ? 'production_protocol_run_edit' : 'production_protocol_run_show', {id: run.id}) }}">{{ (run.status.value == 'draft' and is_granted('@production_protocols.edit') ? 'production.action.edit' : 'production.action.show')|trans }}</a></td></tr>
            {% else %}<tr><td colspan="5" class="text-muted">Noch kein Laufzettel vorhanden.</td></tr>{% endfor %}
        </tbody></table></div>
        {% if is_granted('@production_protocols.create') %}
            {% if protocol_templates|length > 0 %}
                <form class="row g-2 align-items-end mb-4" method="post" action="{{ path('production_protocol_run_new', {id: build_instance.id}) }}">
                    <div class="col-md-8"><label class="form-label" for="protocol-template">Neuen Laufzettel aus Vorlage anlegen</label><select class="form-select" id="protocol-template" name="template_id" required><option value="">Bitte Vorlage auswählen</option>{% for template in protocol_templates %}<option value="{{ template.id }}">{{ template.name }} · v{{ template.publishedRevision.revisionNumber }}</option>{% endfor %}</select></div>
                    <div class="col-md-4"><input type="hidden" name="_token" value="{{ csrf_token('protocol_run_new_' ~ build_instance.id) }}"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus fa-fw"></i> Laufzettel anlegen</button></div>
                </form>
            {% else %}
                <p class="text-muted">Es gibt noch keine aktive, veröffentlichte Laufzettelvorlage.</p>
            {% endif %}
        {% endif %}
    {% endif %}
    {% if is_granted('@production_datasheets.read') %}
        <section class="mt-4">
            <div class="d-flex align-items-center mb-2"><h5 class="mb-0"><i class="fa-solid fa-file-pdf fa-fw"></i> Kundendatenblätter</h5>{% if is_granted('@production_datasheet_templates.read') %}<a class="btn btn-sm btn-outline-secondary ms-auto" href="{{ path('production_datasheet_template_index') }}">Vorlagen verwalten</a>{% endif %}</div>
            {% if build_instance.datasheets|length > 0 %}<div class="table-responsive mb-3"><table class="table table-sm align-middle"><thead><tr><th>Dokument</th><th>Revision</th><th>Freigegeben</th><th>Prüfsumme</th><th></th></tr></thead><tbody>{% for document in build_instance.datasheets %}<tr><td>{{ document.template.productTitle }}</td><td>R{{ document.documentRevision }} <small class="text-muted">Vorlage v{{ document.revision.revisionNumber }}</small></td><td>{{ document.releasedAt|format_datetime('short', 'short') }}{% if document.releasedBy %}<br><small class="text-muted">{{ document.releasedBy }}</small>{% endif %}</td><td><code>{{ document.sha256Checksum|slice(0, 12) }}…</code></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('production_datasheet_download', {id: document.id}) }}"><i class="fa-solid fa-download fa-fw"></i> PDF</a></td></tr>{% endfor %}</tbody></table></div>{% endif %}
            {% if is_granted('@production_datasheets.create') and datasheet_templates|length > 0 %}
                <div class="list-group mb-3">{% for template in datasheet_templates %}<a class="list-group-item list-group-item-action d-flex align-items-center" href="{{ path('production_datasheet_prepare', {instance: build_instance.id, template: template.id}) }}"><span><strong>{{ template.productTitle }}</strong><br><small class="text-muted">{{ template.name }} · Revision {{ template.publishedRevision.revisionNumber }}</small></span><span class="ms-auto"><i class="fa-solid fa-arrow-right"></i></span></a>{% endfor %}</div>
            {% elseif is_granted('@production_datasheets.create') %}<p class="text-muted">Es gibt noch keine aktive, veröffentlichte Datenblattvorlage.</p>{% endif %}
            <p class="small text-muted">Vorschauen tragen ein DRAFT-Wasserzeichen. Freigegebene Dokumentrevisionen werden geschützt und mit SHA-256-Prüfsumme unveränderlich gespeichert.</p>
        </section>
    {% endif %}
    <section id="attachments" class="mt-4">
        <h5><i class="fa-solid fa-paperclip fa-fw"></i> Anhänge</h5>
        <div class="list-group mb-3">{% for attachment in build_instance.attachments %}<div class="list-group-item d-flex align-items-center gap-2"><span class="badge text-bg-light border">{{ attachment.category }}</span><a href="{{ path('production_build_instance_attachment_download', {id: attachment.id}) }}"><i class="fa-solid fa-download fa-fw"></i> {{ attachment.originalFilename }}</a><small class="text-muted">{{ (attachment.fileSize / 1024)|number_format(1, ',', '.') }} KB · SHA-256 {{ attachment.sha256Checksum|slice(0, 12) }}…</small>{% if is_granted('@production_build_instances.edit') %}<form class="ms-auto" method="post" action="{{ path('production_build_instance_attachment_delete', {id: attachment.id}) }}" {{ stimulus_controller('elements/delete_btn') }} {{ stimulus_action('elements/delete_btn', 'submit', 'submit') }} data-delete-title="{{ 'production.action.confirm_title'|trans }}" data-delete-message="Diesen Anhang endgültig löschen?" data-delete-message-text><input type="hidden" name="_token" value="{{ csrf_token('delete_build_instance_attachment_' ~ attachment.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit"><i class="fa-solid fa-trash fa-fw"></i></button></form>{% endif %}</div>{% else %}<div class="list-group-item text-muted">Noch keine Anhänge vorhanden.</div>{% endfor %}</div>
        {% if is_granted('@production_build_instances.edit') %}<form class="row g-2 align-items-end" method="post" enctype="multipart/form-data" action="{{ path('production_build_instance_attachment_upload', {id: build_instance.id}) }}"><div class="col-md-6"><label class="form-label" for="build-attachment">Datei anhängen</label><input class="form-control" id="build-attachment" type="file" name="attachment" required></div><div class="col-md-3"><label class="form-label" for="build-attachment-category">Kategorie</label><input class="form-control" id="build-attachment-category" name="category" maxlength="64" value="Allgemein"></div><div class="col-md-3"><input type="hidden" name="_token" value="{{ csrf_token('build_instance_attachment_' ~ build_instance.id) }}"><button class="btn btn-outline-primary" type="submit"><i class="fa-solid fa-upload fa-fw"></i> Hochladen</button></div></form>{% endif %}
    </section>
    <h5 class="mt-4">Verwendetes Material</h5><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Bauteil</th><th>Menge</th><th>Quelle</th><th>Lagerort</th></tr></thead><tbody>{% for usage in build_instance.materialUsages %}<tr><td>{{ usage.partName }}</td><td>{{ usage.quantity }}</td><td>{{ usage.fromProjectStock ? 'Auftragsbestand' : usage.sourceLotName|default('Lagerbestand') }}</td><td>{{ usage.sourceLocationName|default('–') }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">Kein Material erfasst.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
