{% extends 'base.html.twig' %}
{% trans_default_domain 'production' %}

{% set status_class = {planning: 'bg-secondary', active: 'bg-primary', paused: 'bg-warning text-dark', completed: 'bg-success', cancelled: 'bg-danger'} %}

{% block title %}{{ 'production.project.label'|trans }} {{ project.projectNumber }}{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div><h1 class="h2 mb-1">{{ 'production.project.label'|trans }} {{ project.projectNumber }}</h1><div class="d-flex align-items-center gap-2"><span class="fs-5">{{ project.name }}</span><span class="badge {{ status_class[project.status.value]|default('bg-secondary') }}">{{ ('production.project.status.' ~ project.status.value)|trans }}</span></div></div>
        <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{{ path('production_project_index') }}"><i class="fa-solid fa-arrow-left fa-fw"></i> {{ 'production.project.plural'|trans }}</a>{% if is_granted('@production_orders.create') %}<a class="btn btn-success" href="{{ path('production_customer_project_new', {project: project.id}) }}"><i class="fa-solid fa-plus fa-fw"></i> {{ 'production.customer_project.new'|trans }}</a>{% endif %}{% if is_granted('@production_projects.edit') %}<a class="btn btn-primary" href="{{ path('production_project_edit', {id: project.id}) }}"><i class="fa-solid fa-pen fa-fw"></i> {{ 'production.action.edit'|trans }}</a>{% endif %}</div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7"><div class="card h-100"><div class="card-header"><strong>{{ 'production.common.description'|trans }}</strong></div><div class="card-body">{{ project.description ? project.description|nl2br : ('production.common.empty'|trans) }}</div></div></div>
        <div class="col-lg-5"><div class="card h-100"><div class="card-header"><strong>{{ 'production.common.notes'|trans }}</strong></div><div class="card-body">{{ project.notes ? project.notes|nl2br : ('production.common.no_notes'|trans) }}</div></div></div>
    </div>

    {% if is_granted('@production_orders.read') %}<div class="card">
        <div class="card-header"><strong><i class="fa-solid fa-clipboard-list fa-fw"></i> {{ 'production.customer_project.plural'|trans }}</strong></div>
        <div class="table-responsive"><table class="table table-sm table-hover mb-0 align-middle">
            <thead><tr><th>{{ 'production.customer_project.number'|trans }}</th><th>{{ 'production.common.name'|trans }}</th><th>{{ 'production.customer.label'|trans }}</th><th>{{ 'production.common.status'|trans }}</th></tr></thead>
            <tbody>{% for order in project.orders %}<tr><td><a href="{{ path('production_customer_project_show', {id: order.id}) }}">{{ order.projectNumber }}</a></td><td>{{ order.name }}</td><td><a href="{{ path('production_customer_show', {id: order.customer.id}) }}">{{ order.customer }}</a></td><td><span class="badge bg-secondary">{{ ('production.customer_project.status.' ~ order.status.value)|trans }}</span></td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">{{ 'production.project.no_orders'|trans }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </div>{% endif %}
{% endblock %}
