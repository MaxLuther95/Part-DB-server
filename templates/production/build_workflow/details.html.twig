{% extends 'main_card.html.twig' %}
{% block title %}Geräteangaben{% endblock %}
{% block card_title %}<i class="fa-solid fa-barcode fa-fw"></i> Geräteangaben und Fertigungsstandort{% endblock %}
{% block card_content %}
    {% include 'production/build_workflow/_steps.html.twig' with {current_step: 2} %}
    {% for error in errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('build_details_' ~ token) }}">
        <div class="mb-4"><label class="form-label fw-bold" for="site">Fertigungsstandort</label><select id="site" class="form-select" name="site_id" required><option value="">Bitte Standort wählen</option>{% for location in locations %}<option value="{{ location.id }}" {{ draft.site_id == location.id ? 'selected' : '' }}>{{ location.fullPath }}</option>{% endfor %}</select><div class="form-text">Bei der Materialauswahl werden nur dieser Standort und seine untergeordneten Lagerorte berücksichtigt.</div></div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Gerät / Baugruppe</th><th>Seriennummer</th><th>Notizen / Grund ohne Seriennummer</th></tr></thead><tbody>
        {% for key, node in draft.nodes %}<tr><td style="padding-left: {{ node.parent ? '2.5rem' : '.5rem' }}"><strong>{{ node.name }}</strong><br><span class="badge text-bg-light border">{{ node.type == 'system' ? 'Systemvorlage' : 'Bauprojekt' }}</span></td><td><input class="form-control" maxlength="128" name="details[{{ key }}][serial]" value="{{ draft.details[key].serial|default('') }}" placeholder="Optional"></td><td><textarea class="form-control" rows="1" name="details[{{ key }}][notes]" placeholder="Pflicht, wenn keine Seriennummer vergeben wird">{{ draft.details[key].notes|default('') }}</textarea></td></tr>{% endfor %}
        </tbody></table></div>
        <button class="btn btn-success" type="submit"><i class="fa-solid fa-arrow-right fa-fw"></i> Material auswählen</button>
        <a class="btn btn-secondary" href="{{ path('production_build') }}">Abbrechen</a>
    </form>
{% endblock %}
