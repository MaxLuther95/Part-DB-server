{% extends 'main_card.html.twig' %}
{% block title %}Bau prüfen{% endblock %}
{% block card_title %}<i class="fa-solid fa-clipboard-check fa-fw"></i> Bau abschließend prüfen{% endblock %}
{% block card_content %}
    {% include 'production/build_workflow/_steps.html.twig' with {current_step: 4} %}
    {% for error in errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('build_finish_' ~ token) }}">
        {% set statuses = ['planned', 'in_progress', 'paused', 'completed', 'installed', 'scrapped'] %}
        <h5>Geräte und Baugruppen</h5>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Bezeichnung</th><th>Seriennummer</th><th>Status</th><th>Notizen</th></tr></thead><tbody>
        {% for key, node in draft.nodes %}
            {% set selected_status = draft.details[key].status|default('in_progress') %}
            <tr>
                <td style="padding-left: {{ node.parent ? '2.5rem' : '.5rem' }}"><strong>{{ node.name }}</strong></td>
                <td>{{ draft.details[key].serial ?: '–' }}</td>
                <td><select class="form-select" name="final[{{ key }}][status]">{% for status in statuses %}<option value="{{ status }}" {{ selected_status == status ? 'selected' : '' }}>{{ ('production.build_instance.status.' ~ status)|trans({}, 'production') }}</option>{% endfor %}</select></td>
                <td><textarea class="form-control" rows="1" name="final[{{ key }}][notes]" placeholder="Optional">{{ draft.details[key].notes|default('') }}</textarea></td>
            </tr>
        {% endfor %}
        </tbody></table></div>
    <h5>Material</h5><table class="table"><thead><tr><th>Bauteil</th><th>Bedarf</th><th>Auftragsbestand</th><th>Reserviert</th><th>Freier Lagerbestand</th></tr></thead><tbody>{% for item in plan.items %}<tr><td>{{ item.part.name }}</td><td>{{ item.required }}</td><td>{{ item.project_stock }}</td><td>{{ item.project_reserved }}</td><td>{{ item.remaining }}</td></tr>{% else %}<tr><td colspan="5" class="text-muted">Kein Lagerteilbedarf.</td></tr>{% endfor %}</tbody></table>
    <div class="alert alert-warning"><strong>Verbindlicher Schritt:</strong> Mit „Bau starten“ werden die Geräte angelegt und die ausgewählten Lagerbestände aus Part-DB ausgebucht.</div>
        <button class="btn btn-success" type="submit"><i class="fa-solid fa-hammer fa-fw"></i> Bau starten und Material ausbuchen</button> <a class="btn btn-outline-secondary" href="{{ path('production_build_workflow_materials', {token: token}) }}">Zurück</a>
    </form>
{% endblock %}
