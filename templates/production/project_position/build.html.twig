{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ 'production.project_position.build_title'|trans }}: {{ position.name }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-hammer fa-fw"></i> {{ 'production.project_position.build_title'|trans }}: {{ position.name }}{% endblock %}

{% block card_content %}
    <p>{{ 'production.project_position.build_intro'|trans }}</p>

    <dl class="row">
        <dt class="col-sm-3">{{ 'production.customer_project.label'|trans }}</dt>
        <dd class="col-sm-9">{{ position.customerProject }}</dd>
        <dt class="col-sm-3">{{ 'production.project_position.label'|trans }}</dt>
        <dd class="col-sm-9">{{ position.name }}</dd>
        <dt class="col-sm-3">{{ 'production.build_instance.template'|trans }}</dt>
        <dd class="col-sm-9">{% if position.systemTemplate %}<a href="{{ path('production_template_show', {id: position.systemTemplate.id}) }}">{{ position.systemTemplate.name }}</a>{% else %}<a href="{{ path('project_info', {id: position.templateProject.id}) }}">{{ position.templateProject.fullPath }}</a>{% endif %}</dd>
    </dl>

    <div class="alert alert-info"><i class="fa-solid fa-circle-info fa-fw"></i> {{ 'production.project_position.build_notice'|trans }}</div>

    <ol class="mb-4">
        <li>{{ 'production.project_position.build_steps.serial'|trans }}</li>
        <li>{{ 'production.project_position.build_steps.site'|trans }}</li>
        <li>{{ 'production.project_position.build_steps.material'|trans }}</li>
        <li>{{ 'production.project_position.build_steps.confirm'|trans }}</li>
    </ol>

    <a class="btn btn-secondary" href="{{ path('production_customer_project_show', {id: position.customerProject.id}) }}"><i class="fa-solid fa-arrow-left fa-fw"></i> {{ 'production.action.cancel'|trans }}</a>
{% endblock %}
