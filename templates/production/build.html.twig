{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ 'production.navigation.build'|trans }}{% endblock %}
{% block card_title %}<i class="fa-solid fa-wrench fa-fw"></i> {{ 'production.navigation.build'|trans }}{% endblock %}

{% block card_content %}
    <p class="text-muted">{{ 'production.build.intro'|trans }}</p>
    {% if is_granted('@projects.edit') %}
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100 border-success">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5"><i class="fa-solid fa-hammer fa-fw text-success"></i> {{ 'production.build.new'|trans }}</h2>
                        <p class="text-muted flex-grow-1">{{ 'production.build.new_short'|trans }}</p>
                        <a class="btn btn-success align-self-start" href="{{ path('production_build_new') }}"><i class="fa-solid fa-hammer fa-fw"></i> {{ 'production.build.new'|trans }}</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5"><i class="fa-solid fa-box-open fa-fw text-primary"></i> {{ 'production.build_instance.register_existing'|trans }}</h2>
                        <p class="text-muted flex-grow-1">{{ 'production.build_instance.register_existing_short'|trans }}</p>
                        <a class="btn btn-outline-primary align-self-start" href="{{ path('production_build_instance_new') }}"><i class="fa-solid fa-box-open fa-fw"></i> {{ 'production.build_instance.register_existing'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <h2 class="h5"><i class="fa-solid fa-list-check fa-fw"></i> {{ 'production.build.active'|trans }}</h2>
    <div class="list-group">
        {% for instance in build_instances %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('production_build_instance_show', {id: instance.id}) }}">
                <span><strong>{{ instance.serialNumber }}</strong><br><small class="text-muted">{{ instance.contentName }}{% if not instance.systemTemplate and not instance.templateProject %} ({{ 'production.common.deleted_reference'|trans }}){% endif %}</small></span>
                <span class="badge bg-primary">{{ ('production.build_instance.status.' ~ instance.status.value)|trans }}</span>
            </a>
        {% else %}
            <div class="list-group-item text-muted">{{ 'production.build.empty'|trans }}</div>
        {% endfor %}
    </div>
{% endblock %}
