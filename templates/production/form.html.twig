{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}

{% block title %}{{ title|trans }}{% endblock %}

{% block card_title %}
    <i class="fa-solid fa-pen-to-square fa-fw"></i> {{ title|trans }}
{% endblock %}

{% block card_content %}
    {% if intro|default(null) %}<p class="text-muted">{{ intro|trans }}</p>{% endif %}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" type="submit">
                <i class="fa-solid fa-floppy-disk fa-fw"></i> {{ 'production.action.save'|trans }}
            </button>
            {% if delete_route|default(null) %}
                <div class="d-flex gap-2 ms-auto">
                    <a class="btn btn-secondary" href="{{ path(cancel_route, cancel_route_params|default({})) }}">{{ 'production.action.cancel'|trans }}</a>
                    <button class="btn btn-outline-danger" type="submit" form="production-delete-form">
                        <i class="fa-solid fa-trash fa-fw"></i> {{ 'production.action.delete'|trans }}
                    </button>
                </div>
            {% else %}
                <a class="btn btn-secondary" href="{{ path(cancel_route, cancel_route_params|default({})) }}">{{ 'production.action.cancel'|trans }}</a>
            {% endif %}
        </div>
    {{ form_end(form) }}
    {% if delete_route|default(null) %}
        <form id="production-delete-form" method="post" action="{{ path(delete_route, delete_route_params|default({})) }}" data-turbo-confirm="{{ delete_confirm }}">
            <input type="hidden" name="_token" value="{{ csrf_token(delete_token_id) }}">
        </form>
    {% endif %}
{% endblock %}
