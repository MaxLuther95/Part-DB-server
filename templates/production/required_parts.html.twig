{% extends 'main_card.html.twig' %}
{% trans_default_domain 'production' %}
{% block title %}Benötigte Teile{% endblock %}
{% block card_title %}<i class="fa-solid fa-cart-flatbed fa-fw"></i> Benötigte Teile aus beauftragten Kundenprojekten{% endblock %}
{% block card_content %}
    <div class="alert alert-info">Berücksichtigt werden ausschließlich Kundenprojekte mit dem Status „Beauftragt“ oder „In Produktion“. Kundenprojekte in Planung erzeugen keinen Bestellbedarf.</div>
    <form class="row g-2 mb-3" method="get"><input type="hidden" name="missing" value="{{ missing_only ? 1 : 0 }}"><div class="col"><input class="form-control" name="q" value="{{ search }}" placeholder="Bauteil suchen"></div><div class="col-auto"><div class="btn-group"><a class="btn {{ missing_only ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ path('production_required_parts', {missing: 1, q: search}) }}">Nur zu bestellen</a><a class="btn {{ not missing_only ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ path('production_required_parts', {missing: 0, q: search}) }}">Alle benötigten</a></div></div><div class="col-auto"><button class="btn btn-secondary"><i class="fa-solid fa-search fa-fw"></i> Filtern</button></div></form>
    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Bauteil</th><th>Bedarf</th><th>Reserviert</th><th>Projektbestand</th><th>Verbraucht</th><th>Frei</th><th>Zu bestellen</th></tr></thead><tbody>{% for row in rows %}<tr><td><a href="{{ path('part_info', {id: row.part.id}) }}"><strong>{{ row.part.name }}</strong></a><details class="small mt-1"><summary class="text-muted">{{ row.projects|length }} Kundenprojektzuordnungen</summary>{% for detail in row.projects %}<div><a href="{{ path('production_customer_project_show', {id: detail.project.id}) }}">{{ detail.project.projectNumber }}</a>: {{ detail.required }} benötigt, {{ detail.reserved }} reserviert{% if detail.missing > 0 %}, <span class="text-danger">{{ detail.missing }} fehlt</span>{% endif %}</div>{% endfor %}</details></td><td>{{ row.required }}</td><td>{{ row.reserved }}</td><td>{{ row.allocated }}</td><td>{{ row.consumed }}</td><td>{{ row.free }}</td><td>{% if row.to_order > 0 %}<span class="badge bg-danger fs-6">{{ row.to_order }}</span>{% else %}<span class="badge bg-success">0</span>{% endif %}</td></tr>{% else %}<tr><td colspan="7" class="text-muted text-center py-4">Für den gewählten Filter bestehen keine Bedarfe.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
