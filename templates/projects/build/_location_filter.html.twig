<div class="d-flex align-items-center gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#project-build-location-filter-modal">
        <i class="fa-solid fa-filter fa-fw"></i> {% trans %}project.build.location_filter.edit{% endtrans %}
    </button>
    <span class="text-muted">
        {% trans with {
            '%default%': location_filter.defaultAllowed ? ('project.build.location_filter.allowed'|trans) : ('project.build.location_filter.denied'|trans),
            '%count%': location_filter.explicitStateCount
        } %}project.build.location_filter.summary{% endtrans %}
    </span>
</div>

<div class="modal fade" id="project-build-location-filter-modal" tabindex="-1"
     aria-labelledby="project-build-location-filter-title" aria-hidden="true"
     data-allowed-label="{{ 'project.build.location_filter.allowed'|trans }}"
     data-denied-label="{{ 'project.build.location_filter.denied'|trans }}"
     {{ stimulus_controller('pages/project_build_location_filter') }}>
    <form method="get" action="{{ path('project_build', {'id': project.id}) }}"
          data-action="submit->pages--project-build-location-filter#apply">
        <input type="hidden" name="n" value="{{ number_of_builds }}">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="project-build-location-filter-title">
                        {% trans %}project.build.location_filter.title{% endtrans %}
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">{% trans %}project.build.location_filter.help{% endtrans %}</p>

                    <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                        <strong>{% trans %}project.build.location_filter.default{% endtrans %}</strong>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2"
                             style="flex: 0 0 11rem">
                            <input type="hidden" name="location_filter[default]"
                                   value="{{ location_filter.defaultAllowed ? 'true' : 'false' }}"
                                   data-pages--project-build-location-filter-target="defaultInput">
                            <input type="checkbox" class="form-check-input" role="switch"
                                   {% if location_filter.defaultAllowed %}checked{% endif %}
                                   data-pages--project-build-location-filter-target="defaultCheckbox"
                                   data-action="change->pages--project-build-location-filter#changeDefault">
                            <span class="d-inline-block" style="min-width: 7.5rem"
                                  data-pages--project-build-location-filter-target="defaultLabel"></span>
                        </div>
                    </div>
                    <div class="form-text mb-2">
                        {% trans %}project.build.location_filter.filter_saved_help{% endtrans %}
                    </div>

                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-action="pages--project-build-location-filter#expandAll">
                            <i class="fa-solid fa-angles-down fa-fw"></i> {% trans %}project.build.location_filter.expand_all{% endtrans %}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-action="pages--project-build-location-filter#collapseAll">
                            <i class="fa-solid fa-angles-up fa-fw"></i> {% trans %}project.build.location_filter.collapse_all{% endtrans %}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning ms-auto"
                                data-action="pages--project-build-location-filter#invert">
                            <i class="fa-solid fa-right-left fa-fw"></i> {% trans %}project.build.location_filter.invert{% endtrans %}
                        </button>
                    </div>

                    <div class="list-group">
                        <div class="list-group-item d-flex align-items-center gap-2"
                             data-pages--project-build-location-filter-target="unassignedRow">
                            <span class="fa-fw"></span>
                            <input type="checkbox" class="form-check-input tristate flex-shrink-0"
                                   name="location_filter[unassigned]"
                                   value="{{ location_filter.unassignedAllowed is same as(true) ? 'true' : (location_filter.unassignedAllowed is same as(false) ? 'false' : 'indeterminate') }}"
                                   data-pages--project-build-location-filter-target="state"
                                   data-location-id="unassigned">
                            <span class="flex-grow-1"><em>{% trans %}project.build.location_filter.unassigned{% endtrans %}</em></span>
                            <i class="fa-solid fa-fw" data-pages--project-build-location-filter-target="statusIcon"></i>
                        </div>

                        {% for node in storage_location_tree %}
                            {% set location = node.location %}
                            {% set explicit_state = location_filter.explicitState(node.id) %}
                            <div class="list-group-item align-items-center gap-2 location-filter-row"
                                 data-pages--project-build-location-filter-target="row"
                                 data-location-id="{{ node.id }}" data-parent-id="{{ node.parent_id ?? '' }}"
                                 data-level="{{ node.level }}"
                                style="display: flex; padding-left: {{ 0.75 + node.level * 1.75 }}rem">
                                {% if node.has_children %}
                                    <button type="button"
                                            class="btn btn-link p-0 text-body d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                            style="width: 1.25rem; height: 1.25rem"
                                            aria-expanded="false" data-location-id="{{ node.id }}"
                                            data-action="pages--project-build-location-filter#toggle">
                                        <i class="fa-solid fa-chevron-right fa-fw" data-pages--project-build-location-filter-target="toggleIcon"></i>
                                    </button>
                                {% else %}
                                    <span class="flex-shrink-0" style="width: 1.25rem; height: 1.25rem"></span>
                                {% endif %}
                                <input type="checkbox" class="form-check-input tristate flex-shrink-0"
                                       name="location_filter[locations][{{ node.id }}]"
                                       value="{{ explicit_state is same as(true) ? 'true' : (explicit_state is same as(false) ? 'false' : 'indeterminate') }}"
                                       data-pages--project-build-location-filter-target="state"
                                       data-location-id="{{ node.id }}">
                                <span class="flex-grow-1">{{ location.name }}</span>
                                <i class="fa-solid fa-fw" data-pages--project-build-location-filter-target="statusIcon"></i>
                            </div>
                        {% else %}
                            <div class="list-group-item text-muted">{% trans %}project.build.location_filter.empty{% endtrans %}</div>
                        {% endfor %}
                    </div>

                    <div class="mt-3 small">
                        <span class="d-inline-flex align-items-center gap-1 me-3">
                            <input type="checkbox" class="form-check-input m-0" checked disabled aria-hidden="true">
                            {% trans %}project.build.location_filter.allowed{% endtrans %}
                        </span>
                        <span class="d-inline-flex align-items-center gap-1 me-3">
                            <input type="checkbox" class="form-check-input m-0" disabled aria-hidden="true">
                            {% trans %}project.build.location_filter.denied{% endtrans %}
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <input type="checkbox" class="form-check-input tristate m-0" value="indeterminate"
                                   disabled aria-hidden="true">
                            {% trans %}project.build.location_filter.inherit{% endtrans %}
                        </span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        {% trans %}modal.cancel{% endtrans %}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        {% trans %}project.build.location_filter.apply{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
