{% block serial_number_widget %}
    <div {{ block('widget_container_attributes') }} data-controller="production--serial-number">
        <div class="d-flex gap-2 align-items-start">
            <div style="flex: 0 0 10%; min-width: 5rem;"><label class="form-label" for="{{ form.prefix.vars.id }}">Präfix</label>{{ form_widget(form.prefix) }}{{ form_errors(form.prefix) }}</div>
            <div class="flex-grow-1" style="min-width: 0;"><label class="form-label" for="{{ form.number.vars.id }}">Nummer</label>{{ form_widget(form.number) }}{{ form_errors(form.number) }}</div>
        </div>
        <div class="mt-2">{{ form_widget(form.confirmed) }}{{ form_errors(form.confirmed) }}</div>
        <small class="text-muted" data-serial-hint>Vorschläge sind nicht reserviert. Bitte die Nummer am Gerät prüfen.</small>
    </div>
{% endblock %}
